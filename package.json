{
  "name": "simple-crud-api",
  "version": "1.0.0",
  "description": "Simple CRUD API with Node.js and Typescript",
    "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development ts-node-dev src/server.ts",
    "start:prod": "cross-env NODE_ENV=production npm run build && node dist/server.js",
    "start:multi": "cross-env MULTI=true ts-node src/cluster.ts",
    "test": "jest",
    "build": "npm run clean && tsc",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "author": "nos64",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
